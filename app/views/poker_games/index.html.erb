<% if authenticated? %>
  <%= link_to 'Create New Game', new_poker_game_path, class: 'btn btn-primary mb-3' %>
<% else %>
  <%= link_to 'Admin Login', new_session_path %>
<% end %>

<div class="row">
  <% @poker_games.each do |poker_game| %>
    <div class="col-sm-4 border border-primary rounded-3">
      <div class="card-header p-3 text-center">
        <div class="row gx-0">
          <div class="col-sm-3 border border-primary card rounded-3">
            <div class="row"><div class="col-12"><div class="bg-primary text-secondary"><%= poker_game.datetime.strftime('%a').upcase %>, <%= poker_game.datetime.strftime('%b').upcase %></div></div></div>
            <div class="row"><div class="col-12"><div class="display-4"><%= poker_game.datetime.day %></div></div></div>
            <div class="row"><div class="col-12"><div class="bg-primary text-secondary"><%= poker_game.datetime.strftime('%I:%M %p') %></div></div></div>
          </div>
          <div class="col-sm-9">
            <h5 class="card-title text-center"><%= poker_game.title %>
              <% if authenticated? %>
                <%= link_to(fa_icon("pencil", class: "text-info"), edit_poker_game_path(poker_game)) %>
              <% end %>
            </h5>
            <div class="card-text">
              <small><%= poker_game.location %></small>
            </div>
            <div class="card-text">
              <small><%= poker_game.datetime.to_formatted_s(:custom_12h) %></small>
            </div>
          </div>
        </div>
      </div>
      <div class="card-body p-3">
        <div class="accordion" id="accordion<%= poker_game.id %>">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAdd<%= poker_game.id %>" aria-expanded="true" aria-controls="collapseAdd<%= poker_game.id %>">
                Sign Up
              </button>
            </h2>
            <div id="collapseAdd<%= poker_game.id %>" class="accordion-collapse collapse" data-bs-parent="#accordion<%= poker_game.id %>">
              <div class="accordion-body">
                <div>
                  <%= bootstrap_form_with model: PokerGameEntry.new do |poker_entry_form| %>
                    <%= poker_entry_form.hidden_field :poker_game_id, value: poker_game.id %>
                    <div class="mb-3">
                      <%= poker_entry_form.text_field :name, placeholder: 'Your Name for the List' %>
                    </div>
                    <div class="mb-3">
                      <%= poker_entry_form.submit 'Sign Up', class: "btn btn-primary" %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
          <% if poker_game.poker_game_entries.present? %>
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseList<%= poker_game.id %>" aria-expanded="true" aria-controls="collapseList<%= poker_game.id %>">
                  Show the List
                </button>
              </h2>
              <div id="collapseList<%= poker_game.id %>" class="accordion-collapse collapse show" data-bs-parent="#accordion<%= poker_game.id %>">
                <div class="accordion-body">
                  <ol>
                    <% poker_game.poker_game_entries.each do |poker_game_entry| %>
                      <li>
                        <%= poker_game_entry.name %>
                        <% if authenticated? %>
                          <%= link_to(fa_icon("delete-left", class: "text-danger"), poker_game_entry, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }) %>
                        <% end %>
                      </li>
                    <% end %>
                  </ol>
                </div>
              </div>
            </div>
          <% else %>
            Nobody on the list yet. Be the first to sign up!
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
